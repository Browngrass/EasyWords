<Window x:Class="EasyWords.CustomWordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý từ" Height="420" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#F0F0F0" Topmost="True">

    <Window.Resources>
        <!-- Template chuẩn cho TabItem để không bị lóa trắng -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="#2D2D30" BorderBrush="#444444" BorderThickness="1,1,1,0" 
                                CornerRadius="4,4,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="TabText" Text="{TemplateBinding Header}" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0E639C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0E639C"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderBrush="#444444" BorderThickness="1">
            <!-- TAB 1: CUSTOM WORDS -->
            <TabItem Header="Custom Words">
                <Grid Margin="10">
                    <ListBox x:Name="CustomWordsList" Background="#2D2D30" BorderBrush="#444444" BorderThickness="1" Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Word}" FontSize="14" VerticalAlignment="Center" Foreground="#FFFFFF" Grid.Column="0"/>

                                    <Border Background="#3F3F46" CornerRadius="3" Padding="4,1" Margin="8,0" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Lang}" FontSize="11" Foreground="#A0A0A0"/>
                                    </Border>

                                    <Button Content="Sửa" Width="50" Height="24" Margin="0,0,5,0" Grid.Column="2"
                                            Background="#0E639C" Foreground="White" BorderThickness="0" Click="EditButton_Click"/>

                                    <Button Content="Xóa" Width="50" Height="24" Grid.Column="3"
                                            Background="#A82A2A" Foreground="White" BorderThickness="0" Click="RemoveCustomButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: FAVORITES -->
            <TabItem Header="Favorites (Yêu thích)">
                <Grid Margin="10">
                    <ListBox x:Name="FavWordsList" Background="#2D2D30" BorderBrush="#444444" BorderThickness="1" Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="★ " Foreground="#FFD700" FontSize="14"/>
                                        <TextBlock Text="{Binding}" FontSize="14" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <Button Content="Bỏ thích" Width="65" Height="24" Grid.Column="1"
                                            Background="#3A3A3C" Foreground="#FF8888" BorderThickness="0" Click="UnfavButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Content="Đóng" Width="80" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0" Grid.Row="1"
                Background="#3A3A3C" Foreground="White" BorderThickness="0" Click="CloseButton_Click"/>
    </Grid>
</Window>