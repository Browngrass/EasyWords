<Window x:Class="EasyWords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Easywords" Height="150" Width="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Icon="logo.ico">

    <Border CornerRadius="8" 
        Background="#F3F3F3" 
        BorderBrush="#CCCCCC" 
        BorderThickness="1"
        MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.2" ShadowDepth="2"/>
        </Border.Effect>

        <Grid Margin="10">
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <TextBlock Text="Easywords" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>


                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Minimize -->
                        <Button Content="—" 
                                Width="20" Height="18" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Foreground="#666666" 
                                FontSize="10"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="0,0,2,0"
                                Click="MinimizeButton_Click"/>

                        <!-- Close -->
                        <Button Content="✕" 
                                Width="20" Height="18" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Foreground="#666666" 
                                FontWeight="Bold"
                                FontSize="10"
                                Cursor="Hand"
                                Focusable="False"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ListBox -->
                <ListBox x:Name="SuggestionList" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="14" 
                         Height="90"
                         Focusable="False"
                         SelectionChanged="SuggestionList_SelectionChanged"/>

                <TextBlock Text="ESC to hide | Click to select" FontSize="9" Foreground="#888888" Margin="0,2,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
