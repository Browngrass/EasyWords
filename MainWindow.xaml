<Window x:Class="EasyWords.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Easywords" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False" 
        ShowActivated="False"
        Icon="logo.ico">

    <!-- Dark Mode Curved -->
    <Border Background="#1E1E1E" 
            CornerRadius="8" 
            BorderBrush="#333333" 
            BorderThickness="1" 
            Padding="6"
            Margin="5"
            MouseLeftButtonDown="Window_MouseDown">

        <!-- Effect -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.5" ShadowDepth="3" Color="Black"/>
        </Border.Effect>

        <StackPanel Width="280">
            <!-- Mini Header -->
            <Grid Margin="2,0,2,8">
                <StackPanel VerticalAlignment="Center">
                    <!-- Title -->
                    <TextBlock Text="EasyWords" 
                               FontWeight="Bold" 
                               FontSize="15" 
                               Foreground="#F0F0F0"/>

                    <!-- Keybinds -->
                    <StackPanel x:Name="KeybindHelpPanel" Margin="0,6,0,0">
                        <TextBlock Text="• [Tab / ↓ / ↑]  Chuyển từ gợi ý" 
                                   FontSize="11"
                                   Foreground="#4EC9B0" 
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="• [Enter]  Chọn từ" 
                                   FontSize="11" 
                                   Foreground="#4EC9B0"/>
                    </StackPanel>
                </StackPanel>

                <!-- - & x -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="—" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="12" Cursor="Hand" Focusable="False" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="12" Cursor="Hand" Focusable="False" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ListBox -->
            <ListBox x:Name="SuggestionList" 
                     SelectionChanged="SuggestionList_SelectionChanged"
                     KeyDown="SuggestionList_KeyDown"
                     Background="Transparent" 
                     Foreground="White" 
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="4" 
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D30"/>
                                        </Trigger>

                                        <!-- TAB -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#37373D"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#007ACC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Word}" 
                                       VerticalAlignment="Center" 
                                       FontSize="13" 
                                       Foreground="#F0F0F0"
                                       FontFamily="Segoe UI"/>

                            <!-- ⭐ -->
                            <Button Grid.Column="1" 
                                    Content="{Binding IconFav}" 
                                    Click="FavButton_Click"
                                    Tag="{Binding Word}"
                                    Background="Transparent" 
                                    Foreground="Gold" 
                                    BorderThickness="0" 
                                    FontSize="14" 
                                    Cursor="Hand"
                                    Focusable="False"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Text -->
            <TextBlock Text="ESC to hide | Click to select" 
                       FontSize="9" 
                       Foreground="#555555" 
                       Margin="0,4,2,0" 
                       HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
